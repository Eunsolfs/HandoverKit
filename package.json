{
  "name": "handoverkit",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "db:generate": "vp run --filter @handoverkit/db db:generate",
    "db:migrate": "vp run --filter @handoverkit/server db:migrate",
    "db:studio": "vp run --filter @handoverkit/db db:studio",
    "dev": "vp run -r --parallel dev",
    "knip": "knip",
    "prepare": "vp config",
    "ready": "vp check && vp run knip && vp test && vp run test:e2e && vp run -r build",
    "seed:demo": "node scripts/seed-demo.ts",
    "test:e2e": "vp run --filter @handoverkit/web test:e2e"
  },
  "devDependencies": {
    "@handoverkit/auth": "workspace:*",
    "@handoverkit/config": "workspace:*",
    "@handoverkit/db": "workspace:*",
    "@shadcn/lint": "catalog:",
    "@types/node": "catalog:",
    "drizzle-orm": "catalog:",
    "knip": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.15.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=12.15.0"
  }
}
