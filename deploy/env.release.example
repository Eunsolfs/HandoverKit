# 易交接生产环境变量模板
# 用法：cp env.example .env && 编辑本文件（.env 不要提交到仓库）
# 一键安装会由 handoverkit-ops.sh 自动生成，无需手填。

# 镜像地址。升级时执行 bash handoverkit-ops.sh upgrade v0.1.2 会自动更新此项。
# 若使用私有 GHCR 包，请先 docker login ghcr.io；也可换成自己的镜像仓库/离线镜像。
HK_IMAGE=ghcr.io/eunsolfs/handoverkit:latest

# 宿主机端口（反向代理指向 http://127.0.0.1:APP_PORT）
APP_PORT=8080

# 浏览器访问的完整地址（含协议）。必须与实际访问地址完全一致，否则登录会被 Origin 校验拒绝。
# 本机/局域网：http://服务器IP:8080；HTTPS 反代：https://handover.example.com
BETTER_AUTH_URL=http://YOUR_SERVER_IP:8080

# 会话签名密钥（>=32 字符）：openssl rand -hex 32
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_32_BYTES_HEX

# 首次启动创建的超级管理员（仅当数据库没有超级管理员时生效；登录后立即改密）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
SEED_ADMIN_NAME=系统管理员

# 时区
TZ=Asia/Shanghai
