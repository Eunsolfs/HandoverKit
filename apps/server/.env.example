# Better Auth：生产环境必须换成随机 32+ 字符密钥
BETTER_AUTH_SECRET=please-change-me-to-a-random-32-plus-char-secret
# 浏览器访问的站点地址（开发为 Vite 5173，生产为域名/https）
BETTER_AUTH_URL=http://localhost:5173
# SQLite 文件路径（相对 apps/server 目录；Docker 中为 /data/app.db）
DATABASE_URL=local.db
PORT=3000
# 首次启动自动创建超级管理员（仅当系统无超级管理员时）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME=系统管理员
