# 复制本文件为根目录 .env 后填写：cp .env.example .env
# .env 已被 .gitignore 忽略，不要提交真实密钥。

# Better Auth 签名密钥（必填，>=32 字符）：openssl rand -base64 32
BETTER_AUTH_SECRET=

# 浏览器访问的完整地址，必须与用户实际打开的地址一致（含协议；HTTPS 反向代理时用 https://域名）。
# 不一致会导致登录/会话接口被 Better Auth 的 Origin 校验拒绝（403）。
BETTER_AUTH_URL=http://localhost:3000

# 宿主机映射端口；反向代理指向 http://127.0.0.1:APP_PORT
APP_PORT=3000

# 时区：影响日志与服务器时间展示；业务日期按团队时区存储
TZ=Asia/Shanghai

# 首次启动自动创建超级管理员（仅当数据库中没有超级管理员时生效；登录后立即改密）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME=系统管理员

# 构建镜像标签，升级/回滚时便于区分（默认 latest）
APP_VERSION=latest
